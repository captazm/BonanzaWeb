rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{product} {
      allow read: if true;
      allow write: if true;
    }
    match /posts/{post} {
      allow read: if true;
      allow write: if true;
    }
    match /messages/{message} {
      allow read: if true;
      allow write: if true;
    }
    match /orders/{order} {
      allow read: if true;
      allow write: if true;
    }
    match /orderNotes/{note} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{setting} {
      allow read: if true;
      allow write: if true;
    }
  }
}
